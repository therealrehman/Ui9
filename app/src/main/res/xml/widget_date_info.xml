<?xml version="1.0" encoding="utf-8"?>
<!-- Date: 2 x 2 cells to start with, can be made bigger (never smaller than 2 x 2). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.oklabs.oneui9launcher.WidgetSetupActivity"
    android:description="@string/widget_date_desc"
    android:initialLayout="@layout/widget_date"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_date"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
