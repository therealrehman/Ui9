<?xml version="1.0" encoding="utf-8"?>
<!-- Mini clock: 2 x 2 cells to start with, can be made as small as 2 x 1 and as big as the page. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.oklabs.oneui9launcher.WidgetSetupActivity"
    android:description="@string/widget_clock_small_desc"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_clock_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
