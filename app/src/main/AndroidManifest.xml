<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the quick menu start the system "Uninstall app?" dialog (Android 9+ needs this). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Step 7b: swipe down on the Home screen opens the notification panel. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Step 8a: lets the wallpaper slide with the pages. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />

    <!-- Android 11+ hides other apps unless declared. These let the launcher see every
         launchable app plus the default Phone / Messages / Browser / Camera / Settings. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Step 6: lets the launcher see the apps that offer widgets (even ones with no launcher icon). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Step 6c1: the Clock and Date widgets open the phone's Clock / Calendar app when tapped. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUI.Home">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Step 13: long-press the launcher icon > Settings. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Step 6c2: setup screen of the launcher's own widgets. Android opens it when one is added; the launcher opens it
             again from the widget's menu ("Widget settings"). -->
        <activity
            android:name=".WidgetSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OneUI.Setup">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Step 9a / 13: Settings (all settings, contact and policies). Opened from the Home screen's long-press menu, the Apps screen menu and the icon shortcut. -->
        <!-- It is also an app of its own: "Launcher Settings" shows up in the Apps screen (and in any other launcher) and opens this UI. -->
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="true"
            android:label="@string/settings_app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OneUI.Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step 6c1: the launcher's own widgets. They show up in the widget picker like any other app's widgets. -->
        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".ClockSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_small_info" />
        </receiver>

        <!-- Step 6c2: the analog clock. -->
        <receiver
            android:name=".AnalogClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_info" />
        </receiver>

        <receiver
            android:name=".DateWidgetProvider"
            android:exported="true"
            android:label="@string/widget_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_info" />
        </receiver>

        <!-- Step 9b: counts the notifications of each app for the badges on the icons (only after the person allows
             "Notification access"; nothing is read or stored except the counts). -->
        <service
            android:name=".BadgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Step 7b: lets the launcher lock the screen on a double-tap (only "lock the screen", nothing else). -->
        <receiver
            android:name=".LockAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lock_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
