<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the quick menu start the system "Uninstall app?" dialog (Android 9+ needs this). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Step 7b: swipe down on the Home screen opens the notification panel. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Step 8a: lets the wallpaper slide with the pages. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Step 16a: the Quick panel. It shows the state of Wi-Fi / Bluetooth / mobile data / location (read-only), and changes
         brightness, auto rotate and Do not disturb only after the person allows each one in the phone's own settings. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Step 28b: optional. Only when the person grants it once with adb (pm grant), Location, Dark mode and Battery saver are switched directly. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Step 26: shows whether NFC is on (the button itself is switched by the Quick panel service). -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Step 50 (Huawei plan, step 1): the Quick panel over other apps WITHOUT the Accessibility service. "Draw over other apps" lets the panel
         window show above the app you are in; a small foreground service keeps it ready and its notification opens it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ hides other apps unless declared. These let the launcher see every
         launchable app plus the default Phone / Messages / Browser / Camera / Settings. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Step 6: lets the launcher see the apps that offer widgets (even ones with no launcher icon). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Step 6c1: the Clock and Date widgets open the phone's Clock / Calendar app when tapped. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <!-- Step 20: the Quick panel's music player shows (and opens) the phone's own music app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUI.Home">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <!-- The Home screen. Only HOME here: the app icon you tap (in any launcher) is the Settings activity below.
                 Some phones hide an app whose Home activity also carries the LAUNCHER category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Step 6c2: setup screen of the launcher's own widgets. Android opens it when one is added; the launcher opens it
             again from the widget's menu ("Widget settings"). -->
        <activity
            android:name=".WidgetSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OneUI.Setup">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The app icon: this is what you tap in the phone's app list (and in this launcher's Apps screen). It opens the Settings UI (all settings, contact and policies), where you can make it your Home app.
             Also opened from the Home screen's long-press menu and the Apps screen menu. -->
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OneUI.Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Step 52 (Huawei plan, step 3): long-press the app icon: Quick panel / Notifications. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Step 52: the invisible screen the Quick Settings tile and the App shortcuts start; it opens the Quick panel. -->
        <activity
            android:name=".PanelShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Step 52: the "Quick panel" tile for the phone's Quick Settings. -->
        <service
            android:name=".PanelTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_panel"
            android:label="Quick panel"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Step 6c1: the launcher's own widgets. They show up in the widget picker like any other app's widgets. -->
        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".ClockSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_small_info" />
        </receiver>

        <!-- Step 6c2: the analog clock. -->
        <receiver
            android:name=".AnalogClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_info" />
        </receiver>

        <receiver
            android:name=".DateWidgetProvider"
            android:exported="true"
            android:label="@string/widget_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_info" />
        </receiver>

        <!-- Step 9b: counts the notifications of each app for the badges on the icons (only after the person allows
             "Notification access"; nothing is read or stored except the counts). -->
        <service
            android:name=".BadgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Step 7b: lets the launcher lock the screen on a double-tap (only "lock the screen", nothing else). -->
        <receiver
            android:name=".LockAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lock_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Step 50: the Quick panel over other apps without Accessibility (Settings > Quick panel > Quick panel over other apps). -->
        <service
            android:name=".PanelOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the Quick panel window ready to open over other apps" />
        </service>

        <!-- Step 22: the optional system-wide Quick panel (Settings > Quick panel > Open in every app). -->
        <service
            android:name=".PanelAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/panel_accessibility" />
        </service>

    </application>

</manifest>
