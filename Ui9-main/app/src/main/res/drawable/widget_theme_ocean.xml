<?xml version="1.0" encoding="utf-8"?>
<!-- "Ocean" background of the launcher's own widgets (Step 14): gradient glass.
     Three layers: the see-through colour gradient, a soft sheen from the top, and a hairline light edge.
     The two colours come from WidgetThemes in WidgetConfig.kt - change them there and regenerate. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#B316D3E6"
                android:startColor="#B32F8CFF"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#5CFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
