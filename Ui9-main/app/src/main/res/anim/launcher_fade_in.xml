<?xml version="1.0" encoding="utf-8"?>
<!-- Step 31: Home appears with a soft fade 0 -> 100 and a tiny zoom-in (coming back from an app, unlock, Home button). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="240" android:interpolator="@android:interpolator/decelerate_cubic" />
    <scale android:fromXScale="0.96" android:toXScale="1.0" android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" android:interpolator="@android:interpolator/decelerate_cubic" />
</set>
