<?xml version="1.0" encoding="utf-8"?>
<!-- Step 22: only "a window changed" events are listened to. Step 24: canTakeScreenshot is used only to blur the screen behind the panel (never saved or sent).
     Step 26: canRetrieveWindowContent is used only to find a button by its name in the phone's own Quick settings (Wi-Fi, Bluetooth...) and press it for the
     one-tap buttons of the Quick panel; canPerformGestures sends the tap when the phone ignores a click. Nothing else on the screen is read, stored or sent. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/panel_service_desc"
    android:isAccessibilityTool="false"
    android:notificationTimeout="30" />
